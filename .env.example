# GEMINI_API_KEY: Required for Gemini AI API calls (Transcription & Burmese Subtitle Translation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional server-side Groq API key for Whisper transcription fallback.
GROQ_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
